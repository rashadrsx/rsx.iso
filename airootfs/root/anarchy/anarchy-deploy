#!/bin/bash
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "${GREEN}[+]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
err() { echo -e "${RED}[-]${NC} $1"; }

echo -e "${CYAN}"
echo "    ___                           __          "
echo "   /   |  ____  ____ ___________/ /_  __  __ "
echo "  / /| | / __ \/ __ \`/ ___/ ___/ __ \/ / / / "
echo " / ___ |/ / / / /_/ / /  / /__/ / / / /_/ /  "
echo "/_/  |_/_/ /_/\__,_/_/   \___/_/ /_/\__, /   "
echo "                                   /____/    "
echo -e "${NC}"
echo -e "${GREEN}Anarchy Deploy — copies setup files into your installed system${NC}"
echo ""

MOUNT_POINT="/mnt"

if ! mountpoint -q "$MOUNT_POINT" 2>/dev/null; then
    err "/mnt is not mounted. Did you finish installing Arch?"
    err "If you used archinstall, type 'exit' first to leave chroot, then run this."
    echo ""
    echo "If your install is mounted elsewhere, run:"
    echo "  MOUNT_POINT=/your/mount anarchy-deploy"
    exit 1
fi

log "Copying anarchy setup files to $MOUNT_POINT/root/anarchy..."
cp -rf /root/anarchy "$MOUNT_POINT/root/"

log "Entering your installed system (arch-chroot)..."
echo ""
echo -e "${CYAN}Running anarchy-setup inside your new system...${NC}"
echo ""

arch-chroot "$MOUNT_POINT" /root/anarchy/anarchy-setup

echo ""
log "All done! You can now reboot into your new system:"
echo -e "  ${CYAN}umount -R /mnt${NC}"
echo -e "  ${CYAN}reboot${NC}"
