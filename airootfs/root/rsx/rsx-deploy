#!/bin/bash
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "${GREEN}[+]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
err() { echo -e "${RED}[-]${NC} $1"; }

echo -e "${CYAN}"
echo "  ____  ______  __"
echo " / __ \/ ___/ |/ /"
echo "/ /_/ /\__ \|   / "
echo "/ _, _/___/ /   | "
echo "/_/ |_|/____/_/|_|"
echo ""
echo -e "${NC}"
echo -e "${GREEN}RSX Deploy — copies setup files into your installed system${NC}"
echo ""

MOUNT_POINT="/mnt"

if ! mountpoint -q "$MOUNT_POINT" 2>/dev/null; then
    err "/mnt is not mounted. Did you finish installing Arch?"
    err "If you used archinstall, type 'exit' first to leave chroot, then run this."
    echo ""
    echo "If your install is mounted elsewhere, run:"
    echo "  MOUNT_POINT=/your/mount rsx-deploy"
    exit 1
fi

log "Copying rsx setup files to $MOUNT_POINT/root/rsx..."
cp -rf /root/rsx "$MOUNT_POINT/root/"

log "Entering your installed system (arch-chroot)..."
echo ""
echo -e "${CYAN}Running rsx-setup inside your new system...${NC}"
echo ""

arch-chroot "$MOUNT_POINT" /root/rsx/rsx-setup

echo ""
log "All done! You can now reboot into your new system:"
echo -e "  ${CYAN}umount -R /mnt${NC}"
echo -e "  ${CYAN}reboot${NC}"
