#!/bin/bash
# Check the active keyboard layout.
# Preferred: xset LED mask (00000000 = US, 00001000 = ARA, 5th char is 1
# when the second layout is active) - needs the xorg-xset package.
# Fallback: first configured layout from setxkbmap (xset not installed).

if command -v xset >/dev/null 2>&1; then
    MASK=$(xset -q | awk '/LED/ {print $10}')
    if [[ $MASK =~ ^.{4}1 ]]; then
        echo "AR"
    else
        echo "US"
    fi
else
    setxkbmap -query | awk '/^layout:/ {split($2, a, ","); print toupper(a[1])}'
fi
