#!/bin/bash
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

DOTFILES_SRC="/root/rsx/dotfiles"
TARGET_USER=""
TARGET_HOME=""

print_banner() {
    echo -e "${CYAN}"
    echo "  ____  ______  __"
    echo " / __ \/ ___/ |/ /"
    echo "/ /_/ /\__ \|   / "
    echo "/ _, _/___/ /   | "
    echo "/_/ |_|/____/_/|_|"
    echo ""
    echo -e "${NC}"
    echo -e "${GREEN}RSX Post-Install Setup${NC}"
    echo ""
}

log() { echo -e "${GREEN}[+]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
err() { echo -e "${RED}[-]${NC} $1"; }

detect_user() {
    if [ -n "$RSX_USER" ]; then
        TARGET_USER="$RSX_USER"
    else
        local users
        users=$(awk -F: '$3 >= 1000 && $3 < 65534 {print $1}' /etc/passwd)
        local count
        count=$(echo "$users" | wc -w)

        if [ "$count" -eq 0 ]; then
            err "No regular user found. Create a user first (useradd -m -G wheel USERNAME)."
            exit 1
        elif [ "$count" -eq 1 ]; then
            TARGET_USER="$users"
        else
            echo -e "${CYAN}Multiple users found:${NC}"
            select u in $users; do
                if [ -n "$u" ]; then
                    TARGET_USER="$u"
                    break
                fi
            done
        fi
    fi

    TARGET_HOME="/home/$TARGET_USER"
    if [ ! -d "$TARGET_HOME" ]; then
        err "Home directory $TARGET_HOME does not exist."
        exit 1
    fi
    log "Setting up for user: ${CYAN}$TARGET_USER${NC} ($TARGET_HOME)"
}

enable_multilib() {
    log "Enabling multilib repository..."
    if ! grep -q "^\[multilib\]" /etc/pacman.conf; then
        sed -i '/^#\[multilib\]/,/^#Include/ s/^#//' /etc/pacman.conf
    fi
    pacman -Sy --noconfirm
}

install_pacman_packages() {
    log "Installing official repository packages..."
    local pacman_pkgs=(
        btop lsd lf mpv kitty neovim fish yt-dlp zsh
        xclip xfce4-clipman-plugin zathura zathura-pdf-poppler
        progress zsh-autosuggestions zsh-syntax-highlighting
        power-profiles-daemon wine qbittorrent nautilus
        ripgrep flameshot dunst
        tesseract tesseract-data-ara tesseract-data-eng
        lazygit rofi 
        base-devel git
        fzf zoxide fastfetch
        rsync
        docker docker-compose
    )

    pacman -S --needed --noconfirm "${pacman_pkgs[@]}"
}

install_yay() {
    if command -v yay &>/dev/null; then
        log "yay is already installed."
        return
    fi

    log "Installing yay..."
    local yay_dir
    yay_dir=$(sudo -u "$TARGET_USER" mktemp -d)
    sudo -u "$TARGET_USER" git clone https://aur.archlinux.org/yay-bin.git "$yay_dir/yay-bin"
    cd "$yay_dir/yay-bin"
    sudo -u "$TARGET_USER" makepkg -si --noconfirm
    cd /
    rm -rf "$yay_dir"
}

install_aur_packages() {
    log "Installing AUR packages..."
    local aur_pkgs=(
        zen-browser-bin
        discord
        telegram-desktop-bin
        obsidian
        silicon
        notify
        lazydocker
        heroic-games-launcher-bin
        brave-bin
        yazi
        greenclip
    )

    sudo -u "$TARGET_USER" yay -S --needed --noconfirm "${aur_pkgs[@]}"
}

deploy_dotfiles() {
    log "Deploying dotfiles to $TARGET_HOME..."

    local config_dir="$TARGET_HOME/.config"
    local project_dir="$TARGET_HOME/Projects"
    local local_bin="$TARGET_HOME/.local/bin"

    mkdir -p "$config_dir" "$local_bin"

    [ -d "$DOTFILES_SRC/fish" ]      && cp -rf "$DOTFILES_SRC/fish" "$config_dir/"
    [ -d "$DOTFILES_SRC/kitty" ]     && cp -rf "$DOTFILES_SRC/kitty" "$config_dir/"
    [ -d "$DOTFILES_SRC/lf" ]        && cp -rf "$DOTFILES_SRC/lf" "$config_dir/"
    [ -d "$DOTFILES_SRC/mpv" ]       && cp -rf "$DOTFILES_SRC/mpv" "$config_dir/"
    [ -d "$DOTFILES_SRC/awesome" ]   && cp -rf "$DOTFILES_SRC/awesome" "$config_dir/"
    [ -d "$DOTFILES_SRC/HyprLand" ]  && cp -rf "$DOTFILES_SRC/HyprLand" "$config_dir/hypr"
    [ -d "$DOTFILES_SRC/i3" ]        && cp -rf "$DOTFILES_SRC/i3" "$config_dir/"
    [ -d "$DOTFILES_SRC/rofi" ]      && cp -rf "$DOTFILES_SRC/rofi" "$config_dir/"
    [ -d "$DOTFILES_SRC/fastfetch" ] && cp -rf "$DOTFILES_SRC/fastfetch" "$config_dir/"
    [ -d "$DOTFILES_SRC/lsd" ]       && cp -rf "$DOTFILES_SRC/lsd" "$config_dir/"
    [ -d "$DOTFILES_SRC/yazi" ]      && cp -rf "$DOTFILES_SRC/yazi" "$config_dir/"
    [ -d "$DOTFILES_SRC/docker" ]    && cp -rf "$DOTFILES_SRC/docker" "$project_dir/"

    if [ -d "$DOTFILES_SRC/bin" ]; then
        cp -rf "$DOTFILES_SRC/bin/"* "$local_bin/"
        chmod +x "$local_bin/"*
    fi

    [ -f "$DOTFILES_SRC/zsh/.zshrc" ]   && cp -f "$DOTFILES_SRC/zsh/.zshrc" "$TARGET_HOME/.zshrc"
    [ -f "$DOTFILES_SRC/.gitconfig" ]    && cp -f "$DOTFILES_SRC/.gitconfig" "$TARGET_HOME/.gitconfig"
    [ -f "$DOTFILES_SRC/.ideavimrc" ]    && cp -f "$DOTFILES_SRC/.ideavimrc" "$TARGET_HOME/.ideavimrc"
    [ -f "$DOTFILES_SRC/.tmux.conf" ]    && cp -f "$DOTFILES_SRC/.tmux.conf" "$TARGET_HOME/.tmux.conf"

    if [ -f "$DOTFILES_SRC/sxhkdrc" ]; then
        mkdir -p "$config_dir/sxhkd"
        cp -f "$DOTFILES_SRC/sxhkdrc" "$config_dir/sxhkd/sxhkdrc"
    fi

    chown -R "$TARGET_USER:$TARGET_USER" "$TARGET_HOME"
    log "Dotfiles deployed."
}

clone_nvim_config() {
    log "Cloning Neovim config..."
    local nvim_dir="$TARGET_HOME/.config/nvim"
    if [ -d "$nvim_dir" ]; then
        warn "Neovim config already exists at $nvim_dir, skipping."
    else
        sudo -u "$TARGET_USER" git clone https://github.com/rashadalsharpini/nvim "$nvim_dir"
    fi
}

set_default_shell() {
    log "Setting default shell to zsh for $TARGET_USER..."
    chsh -s /usr/bin/zsh "$TARGET_USER"
}

enable_services() {
    log "Enabling systemd services..."
    systemctl enable power-profiles-daemon.service 2>/dev/null || true
    systemctl enable NetworkManager.service 2>/dev/null || true
}

main() {
    print_banner

    if [ "$(id -u)" -ne 0 ]; then
        err "This script must be run as root."
        echo "Usage: sudo rsx-setup"
        exit 1
    fi

    if [ ! -d "$DOTFILES_SRC" ]; then
        err "Dotfiles not found at $DOTFILES_SRC"
        err "Make sure you copied the rsx directory to /root/"
        exit 1
    fi

    detect_user
    enable_multilib
    install_pacman_packages
    install_yay
    install_aur_packages
    deploy_dotfiles
    clone_nvim_config
    set_default_shell
    enable_services

    echo ""
    echo -e "${GREEN}============================================${NC}"
    echo -e "${GREEN}  RSX setup complete!${NC}"
    echo -e "${GREEN}  Reboot and enjoy your system.${NC}"
    echo -e "${GREEN}============================================${NC}"
}

main "$@"
