#!/bin/bash
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

DOTFILES_SRC="/root/rsx/dotfiles"
DOTFILES_LIST="/root/rsx/dotfiles.list"
TARGET_USER=""
TARGET_HOME=""

print_banner() {
    echo -e "${CYAN}"
    echo "  ____  ______  __"
    echo " / __ \/ ___/ |/ /"
    echo "/ /_/ /\__ \|   / "
    echo "/ _, _/___/ /   | "
    echo "/_/ |_|/____/_/|_|"
    echo ""
    echo -e "${NC}"
    echo -e "${GREEN}RSX Post-Install Setup${NC}"
    echo ""
}

log() { echo -e "${GREEN}[+]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
err() { echo -e "${RED}[-]${NC} $1"; }

detect_user() {
    if [ -n "$RSX_USER" ]; then
        TARGET_USER="$RSX_USER"
    else
        local users
        users=$(awk -F: '$3 >= 1000 && $3 < 65534 {print $1}' /etc/passwd)
        local count
        count=$(echo "$users" | wc -w)

        if [ "$count" -eq 0 ]; then
            err "No regular user found. Create a user first (useradd -m -G wheel USERNAME)."
            exit 1
        elif [ "$count" -eq 1 ]; then
            TARGET_USER="$users"
        else
            echo -e "${CYAN}Multiple users found:${NC}"
            select u in $users; do
                if [ -n "$u" ]; then
                    TARGET_USER="$u"
                    break
                fi
            done
        fi
    fi

    TARGET_HOME="/home/$TARGET_USER"
    if [ ! -d "$TARGET_HOME" ]; then
        err "Home directory $TARGET_HOME does not exist."
        exit 1
    fi
    log "Setting up for user: ${CYAN}$TARGET_USER${NC} ($TARGET_HOME)"
}

enable_multilib() {
    log "Enabling multilib repository..."
    if ! grep -q "^\[multilib\]" /etc/pacman.conf; then
        sed -i '/^#\[multilib\]/,/^#Include/ s/^#//' /etc/pacman.conf
    fi
    pacman -Sy --noconfirm
}

install_pacman_packages() {
    log "Installing official repository packages..."
    local pacman_pkgs=(
        btop lsd lf mpv kitty neovim fish yt-dlp zsh
        xclip xfce4-clipman-plugin zathura zathura-pdf-poppler
        progress zsh-autosuggestions zsh-syntax-highlighting
        power-profiles-daemon wine qbittorrent nautilus
        ripgrep flameshot dunst
        tesseract tesseract-data-ara tesseract-data-eng
        lazygit rofi lazydocker
        base-devel git
        fzf zoxide fastfetch
        rsync playerctl amberol
        docker docker-compose xorg-xset
        brightnessctl autotiling
        # i3 / X11 helpers
        picom feh maim autorandr wmctrl xdotool xorg-xinput libinput-tools
        # audio
        pipewire-alsa pipewire-pulse pulsemixer pavucontrol
        # fonts
        noto-fonts noto-fonts-extra ttf-noto-nerd ttf-jetbrains-mono-nerd
        ttf-dejavu ttf-liberation ttf-opensans
        # filesystems / system
        ntfs-3g ntfsprogs reflector linux-headers
        # apps / tools
        tmux steam authenticator scrcpy android-tools android-udev
        gnome-shell-extension-caffeine
        # dev / iso building
        cmake archiso python-pyparted
        pciutils
    )

    # These conflict with packages archinstall ships by default and pacman
    # won't swap them under --noconfirm, so drop the old ones first.
    if pacman -Qq pulseaudio &>/dev/null; then
        log "Replacing pulseaudio with pipewire-pulse..."
        pacman -Rdd --noconfirm pulseaudio pulseaudio-bluetooth 2>/dev/null \
            || pacman -Rdd --noconfirm pulseaudio
    fi

    pacman -S --needed --noconfirm "${pacman_pkgs[@]}"
}

install_hardware_packages() {
    if lspci | grep -qi 'nvidia'; then
        log "NVIDIA GPU detected, installing drivers + CUDA..."
        pacman -S --needed --noconfirm \
            nvidia-open-dkms nvidia-utils lib32-nvidia-utils nvidia-settings \
            nvidia-container-toolkit cuda cudnn
    fi

    if grep -qi 'asus' /sys/class/dmi/id/sys_vendor 2>/dev/null; then
        log "ASUS hardware detected, installing asusctl..."
        pacman -S --needed --noconfirm asusctl rog-control-center
        sudo -u "$TARGET_USER" yay -S --needed --noconfirm supergfxctl
        systemctl enable supergfxd.service 2>/dev/null || true
    fi
}

install_yay() {
    if command -v yay &>/dev/null; then
        log "yay is already installed."
        return
    fi

    log "Installing yay..."
    local yay_dir
    yay_dir=$(sudo -u "$TARGET_USER" mktemp -d)
    sudo -u "$TARGET_USER" git clone https://aur.archlinux.org/yay-bin.git "$yay_dir/yay-bin"
    cd "$yay_dir/yay-bin"
    sudo -u "$TARGET_USER" makepkg -si --noconfirm
    cd /
    rm -rf "$yay_dir"
}

install_aur_packages() {
    log "Installing AUR packages..."
    local aur_pkgs=(
        zen-browser-bin
        discord
        telegram-desktop-bin
        obsidian
        silicon
        notify
        heroic-games-launcher-bin
        brave-bin
        yazi
        greenclip
        betterlockscreen
        libinput-gestures
        localsend-bin
        ventoy-bin
        ttf-google-sans
        caffeinated
        gdm-tools
        gdm-settings
    )

    # betterlockscreen pulls i3lock-color, which conflicts with i3lock
    if pacman -Qq i3lock &>/dev/null && ! pacman -Qq i3lock-color &>/dev/null; then
        log "Removing i3lock (replaced by i3lock-color)..."
        pacman -Rdd --noconfirm i3lock
    fi

    sudo -u "$TARGET_USER" yay -S --needed --noconfirm "${aur_pkgs[@]}"
}

deploy_dotfiles() {
    log "Deploying dotfiles to $TARGET_HOME..."

    if [ ! -f "$DOTFILES_LIST" ]; then
        err "Manifest not found: $DOTFILES_LIST"
        return 1
    fi

    # Each manifest line: <live path>  <name inside dotfiles/>
    local live name src dest
    while read -r live name _; do
        [[ -z "$live" || "$live" == \#* ]] && continue
        src="$DOTFILES_SRC/$name"
        dest="${live/#\~/$TARGET_HOME}"

        if [ -d "$src" ]; then
            mkdir -p "$dest"
            cp -rf "$src/." "$dest/"
        elif [ -f "$src" ]; then
            mkdir -p "$(dirname "$dest")"
            cp -f "$src" "$dest"
        else
            continue
        fi
        log "  $name -> ${dest/#"$TARGET_HOME"/\~}"
    done < "$DOTFILES_LIST"

    [ -d "$TARGET_HOME/.local/bin" ] && chmod +x "$TARGET_HOME/.local/bin/"*

    chown -R "$TARGET_USER:$TARGET_USER" "$TARGET_HOME"
    log "Dotfiles deployed."
}

clone_nvim_config() {
    log "Cloning Neovim config..."
    local nvim_dir="$TARGET_HOME/.config/nvim"
    if [ -d "$nvim_dir" ]; then
        warn "Neovim config already exists at $nvim_dir, skipping."
    else
        sudo -u "$TARGET_USER" git clone https://github.com/rashadalsharpini/nvim "$nvim_dir"
    fi
}

set_default_shell() {
    log "Setting default shell to zsh for $TARGET_USER..."
    chsh -s /usr/bin/zsh "$TARGET_USER"
}

enable_services() {
    log "Enabling systemd services..."
    systemctl enable power-profiles-daemon.service 2>/dev/null || true
    systemctl enable NetworkManager.service 2>/dev/null || true
    systemctl enable docker.service 2>/dev/null || true
    systemctl enable bluetooth.service 2>/dev/null || true
}

setup_user_groups() {
    # docker: run docker without sudo, input: needed by libinput-gestures
    log "Adding $TARGET_USER to docker and input groups..."
    usermod -aG docker,input "$TARGET_USER"
}

main() {
    print_banner

    if [ "$(id -u)" -ne 0 ]; then
        err "This script must be run as root."
        echo "Usage: sudo rsx-setup"
        exit 1
    fi

    if [ ! -d "$DOTFILES_SRC" ]; then
        err "Dotfiles not found at $DOTFILES_SRC"
        err "Make sure you copied the rsx directory to /root/"
        exit 1
    fi

    detect_user
    enable_multilib
    install_pacman_packages
    install_yay
    install_aur_packages
    install_hardware_packages
    deploy_dotfiles
    clone_nvim_config
    set_default_shell
    enable_services
    setup_user_groups

    echo ""
    echo -e "${GREEN}============================================${NC}"
    echo -e "${GREEN}  RSX setup complete!${NC}"
    echo -e "${GREEN}  Reboot and enjoy your system.${NC}"
    echo -e "${GREEN}============================================${NC}"
}

main "$@"
